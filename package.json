{
  "name": "hearth-home-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build --config client/vite.config.js",
    "test:server": "node --test tests/server/*.test.js",
    "test:client": "node scripts/test-client.js",
    "test": "npm run test:server && npm run test:client"
  },
  "overrides": {
    "node-addon-api": "8.7.0",
    "postcss": "8.5.28",
    "jsdom": {
      "lru-cache": "11.2.7",
      "undici": "7.29.0"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "vite": "^7.3.6"
  }
}
